#include <stdio.h>
#include <conio.h>
#include <graphics.h>
#include <dos.h>
#include <alloc.h>

#define MAX 20

int px[MAX], py[MAX];
int totalPoints = 0;

void far *robotBG;
int oldX, oldY, first = 1;

/* Heading */
void heading()
{
    setfillstyle(SOLID_FILL, BLUE);
    bar(0,0,639,42);

    setcolor(CYAN);
    rectangle(5,5,634,37);

    setcolor(WHITE);
    settextstyle(1,0,2);
    outtextxy(130,12,"COORDINATE BASED ROBOT SIMULATOR");

    settextstyle(0,0,1);
}

/* Manual coordinate input */
void inputCoordinates()
{
    int i;

    clrscr();

    printf("\n====================================");
    printf("\n   ROBOT COORDINATE INPUT SYSTEM");
    printf("\n====================================");

    printf("\n\nEnter number of points (2-20): ");
    scanf("%d",&totalPoints);

    if(totalPoints < 2 || totalPoints > MAX)
    {
        printf("\nInvalid number of points!");
        getch();
        totalPoints = 0;
        return;
    }

    for(i=0;i<totalPoints;i++)
    {
        printf("\n\nEnter coordinates for P%d",i+1);

        printf("\nX Coordinate (0-190): ");
        scanf("%d",&px[i]);

        printf("Y Coordinate (0-160): ");
        scanf("%d",&py[i]);

        if(px[i]<0 || px[i]>190 ||
           py[i]<0 || py[i]>160)
        {
            printf("\nInvalid coordinates!");
            getch();
            totalPoints = 0;
            return;
        }

        /* Convert coordinates into screen pixels */

        px[i] = 65 + px[i]*2;
        py[i] = 390 - py[i]*2;
    }

    printf("\n\nCoordinates entered successfully!");
    printf("\nPress any key to start simulation...");
    getch();
}

/* Coordinate graph */
void graph()
{
    int i;
    char s[10];

    setcolor(DARKGRAY);

    for(i=85;i<=445;i+=40)
        line(i,65,i,390);

    for(i=70;i<=390;i+=40)
        line(65,i,465,i);

    setcolor(WHITE);

    line(65,390,475,390);
    line(65,390,65,55);

    line(475,390,465,385);
    line(475,390,465,395);

    line(65,55,60,65);
    line(65,55,70,65);

    setcolor(YELLOW);

    outtextxy(480,385,"X");
    outtextxy(55,45,"Y");
    outtextxy(48,395,"0");

    setcolor(LIGHTGRAY);

    for(i=1;i<=9;i++)
    {
        sprintf(s,"%d",i*20);
        outtextxy(65+i*40-8,395,s);
    }

    for(i=1;i<=8;i++)
    {
        sprintf(s,"%d",i*20);
        outtextxy(25,390-i*40-5,s);
    }

    /* Draw robot path */

    setcolor(LIGHTCYAN);

    for(i=0;i<totalPoints-1;i++)
        line(px[i],py[i],px[i+1],py[i+1]);

    /* Draw waypoints */

    for(i=0;i<totalPoints;i++)
    {
        setcolor(YELLOW);
        circle(px[i],py[i],4);

        setfillstyle(SOLID_FILL,YELLOW);
        fillellipse(px[i],py[i],2,2);

        setcolor(LIGHTCYAN);

        sprintf(s,"P%d",i+1);
        outtextxy(px[i]-8,py[i]+9,s);
    }

    setcolor(GREEN);
    outtextxy(px[0]-15,py[0]+22,"START");

    setcolor(RED);
    outtextxy(px[totalPoints-1]-15,
              py[totalPoints-1]-20,"FINISH");
}

