/* Update live information */
void updateData(int x,int y,int progress,char status[])
{
    char s[30];

    setfillstyle(SOLID_FILL,BLACK);

    bar(525,100,625,165);
    bar(495,305,630,345);

    setcolor(WHITE);

    sprintf(s,"%d",(x-65)/2);
    outtextxy(525,105,s);

    sprintf(s,"%d",(390-y)/2);
    outtextxy(525,125,s);

    outtextxy(525,145,"2.0");

    setcolor(YELLOW);
    outtextxy(500,315,status);

    setfillstyle(SOLID_FILL,BLACK);
    bar(502,377,618,388);

    setfillstyle(SOLID_FILL,LIGHTGREEN);

    bar(502,377,502+(progress*115)/100,388);
}

/* Robot joint */
void makeJoint(int x,int y)
{
    setcolor(YELLOW);
    setfillstyle(SOLID_FILL,YELLOW);
    fillellipse(x,y,2,2);
}

/* Humanoid robot */
void robot(int x,int y,int arm,int leg)
{
    setcolor(LIGHTCYAN);
    setfillstyle(SOLID_FILL,BLUE);

    fillellipse(x,y-44,7,8);
    ellipse(x,y-44,0,360,7,8);

    setfillstyle(SOLID_FILL,YELLOW);

    fillellipse(x-3,y-46,1,1);
    fillellipse(x+3,y-46,1,1);

    setcolor(WHITE);
    line(x-3,y-40,x+3,y-40);

    line(x,y-52,x,y-55);
    makeJoint(x,y-56);

    line(x,y-36,x,y-33);

    setcolor(CYAN);
    setfillstyle(SOLID_FILL,BLUE);

    bar(x-9,y-33,x+9,y-14);
    rectangle(x-9,y-33,x+9,y-14);

    setfillstyle(SOLID_FILL,YELLOW);
    fillellipse(x,y-25,2,2);

    setcolor(WHITE);
    line(x-6,y-14,x+6,y-14);

    makeJoint(x-11,y-31);
    makeJoint(x+11,y-31);

    setcolor(LIGHTCYAN);

    line(x-11,y-31,x-15,y-23+arm);
    makeJoint(x-15,y-23+arm);

    line(x-15,y-23+arm,x-17,y-13+arm);

    line(x+11,y-31,x+15,y-23-arm);
    makeJoint(x+15,y-23-arm);

    line(x+15,y-23-arm,x+17,y-13-arm);

    setfillstyle(SOLID_FILL,LIGHTRED);

    fillellipse(x-17,y-11+arm,3,3);
    fillellipse(x+17,y-11-arm,3,3);

    makeJoint(x-5,y-13);
    makeJoint(x+5,y-13);

    setcolor(LIGHTGREEN);

    line(x-5,y-13,x-7+leg,y-7);
    makeJoint(x-7+leg,y-7);

    line(x-7+leg,y-7,x-8+leg,y-2);

    line(x+5,y-13,x+7-leg,y-7);
    makeJoint(x+7-leg,y-7);

    line(x+7-leg,y-7,x+8-leg,y-2);

    setcolor(LIGHTBLUE);

    line(x-8+leg,y-2,x-15+leg,y);
    line(x+8-leg,y-2,x+15-leg,y);
}

/* Robot movement */
void moveRobot(int x,int y,int arm,int leg)
{
    int left=x-22;
    int top=y-59;

    if(!first)
        putimage(oldX-22,oldY-59,robotBG,COPY_PUT);

    getimage(left,top,left+44,top+63,robotBG);

    robot(x,y,arm,leg);

    oldX=x;
    oldY=y;

    first=0;
}

/* Dance animation */
void dance(int x,int y)
{
    int i;

    for(i=0;i<8;i++)
    {
        moveRobot(x,y,
                  (i%2==0)?-12:12,
                  (i%2==0)?-5:5);

        updateData(x,y,0,"DANCING");

        delay(180);

        if(kbhit())
        {
            if(getch()==27)
                break;
        }
    }

    moveRobot(x,y,0,0);
}

/* Follow entered coordinates */
void follow(int dancing)
{
    int i,j;
    int x=px[0],y=py[0];
    int arm,leg;

    char status[20];

    first=1;

    moveRobot(x,y,0,0);

    for(i=0;i<totalPoints-1;i++)
    {
        for(j=1;j<=25;j++)
        {
            if(kbhit())
            {
                if(getch()==27)
                {
                    updateData(x,y,0,"STOPPED");
                    return;
                }
            }

            /* Coordinate interpolation */

            x=px[i]+(px[i+1]-px[i])*j/25;
            y=py[i]+(py[i+1]-py[i])*j/25;

            arm=(j%2==0)?-4:4;
            leg=(j%2==0)?-3:3;

            moveRobot(x,y,arm,leg);

            sprintf(status,"SEGMENT %d",i+1);

            updateData(x,y,
                ((i*25+j)*100)/
                ((totalPoints-1)*25),
                status);

            delay(65);
        }

        moveRobot(px[i+1],py[i+1],0,0);

        if(dancing)
            dance(x,y);
    }

    moveRobot(px[totalPoints-1],
              py[totalPoints-1],0,0);

    updateData(x,y,100,"COMPLETED");

    setcolor(YELLOW);

    outtextxy(160,450,
              "ROBOT REACHED DESTINATION!");

    delay(1500);
}

/* Main menu */
void menu()
{
    cleardevice();

    setbkcolor(BLACK);

    heading();

    setcolor(CYAN);
    rectangle(100,75,540,400);

    settextstyle(1,0,2);

    setcolor(YELLOW);
    outtextxy(205,100,"ROBOT CONTROL");

    settextstyle(0,0,1);

    setcolor(WHITE);

    outtextxy(155,155,"1. FOLLOW PATH + DANCE");
    outtextxy(155,195,"2. FOLLOW PATH ONLY");
    outtextxy(155,235,"3. VIEW GRAPH");
    outtextxy(155,275,"4. EXIT");

    setcolor(LIGHTGREEN);

    outtextxy(145,345,"PRESS NUMBER TO SELECT");
}

/* Main function */
int main()
{
    int gd=DETECT,gm;
    int choice;
    unsigned int size;

    /* Get manual coordinates */

    inputCoordinates();

    if(totalPoints<2)
    {
        printf("\nRestart program and enter valid coordinates.");
        return 0;
    }

    /* Initialize graphics */

    initgraph(&gd,&gm,"C:\\TURBOC3\\BGI");

    size=imagesize(0,0,44,63);

    robotBG=farmalloc(size);

    if(robotBG==NULL)
    {
        closegraph();

        printf("Memory allocation failed!");

        getch();

        return 0;
    }

    while(1)
    {
        menu();

        choice=getch()-'0';

        if(choice==1 || choice==2)
        {
            cleardevice();

            heading();
            graph();
            panel();

            follow(choice==1);

            getch();
        }

        else if(choice==3)
        {
            cleardevice();

            heading();
            graph();
            panel();

            outtextxy(180,450,
                      "GRAPH VIEW - PRESS ANY KEY");

            getch();
        }

        else if(choice==4)
            break;
    }

    farfree(robotBG);

    closegraph();

    return 0;
}
